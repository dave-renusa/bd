# Supabase project "BD Database" (ref csxvtewzlhigrzvpxtvf). Server only.
SUPABASE_URL=https://csxvtewzlhigrzvpxtvf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*.
CRON_SECRET=

# Optional light barrier. When set, open the site once with ?key=<SITE_KEY>.
SITE_KEY=

# Alerts (Resend). ALERT_FROM needs a domain verified in Resend; until then
# Resend only allows onboarding@resend.dev sending to the account owner's email.
RESEND_API_KEY=
ALERT_RECIPIENTS=dave@renusa.org
ALERT_FROM=BD Radar <radar@renusa.report>
SITE_URL=https://bd.renusa.report

# PJM. Defaults to the public queue export; these override it.
PJM_QUEUE_FILE_URL=
PJM_QUEUE_SUBSCRIPTION_KEY=
# Reserved for a registered PJM Data Miner 2 key (not used yet).
PJM_API_KEY=

# Sabin. Found automatically on oppositionreport.org unless set.
SABIN_RESTRICTIONS_URL=
SABIN_CONTESTED_URL=
